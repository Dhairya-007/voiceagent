# Every option below is free. Leave the file untouched to run on the mock
# providers: no install, no network, no account.

# ---- Tier 1: mocks (default) ---------------------------------------
STT_PROVIDER=mock
LLM_PROVIDER=mock
TTS_PROVIDER=mock

# ---- Tier 2: free + local + offline --------------------------------
# STT: uv pip install faster-whisper   (tiny.en is ~75 MB, downloads once)
# STT_PROVIDER=whisper
# WHISPER_MODEL=tiny.en

# LLM: install Ollama, then `ollama pull qwen2.5:3b-instruct`
# LLM_PROVIDER=openai_compat
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:3b-instruct

# TTS on macOS: nothing to install, `say` ships with the OS
# TTS_PROVIDER=say
# SAY_VOICE=Samantha

# TTS on Linux/Windows: brew install piper (or uv pip install piper-tts)
# TTS_PROVIDER=piper
# PIPER_MODEL_PATH=/path/to/en_US-amy-medium.onnx

# ---- Tier 3: free hosted tier (no card) ----------------------------
# Groq's free tier speaks the same OpenAI protocol and is fast enough for voice
# LLM_PROVIDER=openai_compat
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.1-8b-instant
# LLM_API_KEY=gsk_...

# ---- Telephony (optional) ------------------------------------------
# The browser demo needs none of this. Twilio is the only non-free piece in the
# repo, so it is opt-in: a trial account has credit, and the adapter is
# unreachable unless you set this.
# PUBLIC_WS_URL=wss://your-tunnel.ngrok.app/telephony/twilio/stream

# ---- Turn taking ---------------------------------------------------
END_OF_TURN_SILENCE_MS=640
BARGE_IN_SPEECH_MS=240
